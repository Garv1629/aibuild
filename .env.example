# ==============================================================================
# AI BUILD CMS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5173

# Master secret key for server session tokens
JWT_SECRET=aibuild_studio_super_secret_jwt_key_2026_production

# ==============================================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# (If configured, the backend reads/writes directly to Supabase PostgreSQL & Storage)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=cms-media

# Optional direct PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Node environment
NODE_ENV=development

# ==============================================================================
# EMAIL NOTIFICATIONS (RESEND API)
# ==============================================================================
RESEND_API_KEY=re_123456789_abcdef
FROM_EMAIL=AI BUILD Studio <onboarding@resend.dev>
OWNER_EMAIL=your_email@domain.com
