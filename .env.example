# ==============================================================================
# AI BUILD PORTFOLIO & CMS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD POSTGRESQL & MEDIA STORAGE
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Execute the SQL migration in: supabase/migrations/20261028000000_initial_schema.sql
# In your Supabase Project Settings -> API, copy your Project URL & Anon Public Key:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# If Supabase is connected, configure this user under Supabase Auth -> Users.
# If running in local persistent mode without Supabase, the CMS authenticates
# securely against these administrator credentials:
VITE_ADMIN_EMAIL="admin@aibuild.studio"
VITE_ADMIN_PASSWORD="YourSecureAdminPassword2026!"

# ------------------------------------------------------------------------------
# 3. STUDIO & HOSTING
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
